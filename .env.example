PORT=8080
REDIS_URL=redis://localhost:6379
UPSTREAM_URL=http://localhost:9000
MOCK_UPSTREAM_PORT=9000
RATE_LIMIT=20
RATE_WINDOW_SECONDS=10
INSTANCE_ID=local

# Number of proxy hops in front of the gateway, which decides what req.ip
# resolves to and therefore how IP-keyed limits bucket clients. 0 for direct
# connections; 1 behind a single load balancer (Render, an ALB, nginx).
# Never "true" — that trusts the whole X-Forwarded-For chain and lets a
# client spoof itself a fresh bucket per request.
TRUST_PROXY=0

# Ceilings on the limiter's Redis calls. The limiter sits in the hot path of
# every request, so a Redis that is down or slow must fail fast and let the
# request through rather than becoming the gateway's own latency.
REDIS_COMMAND_TIMEOUT_MS=250
REDIS_CONNECT_TIMEOUT_MS=1000

# How long the gateway waits on the upstream before giving up with a 504.
# Without a deadline, an upstream that accepts connections and never answers
# holds gateway sockets open indefinitely.
UPSTREAM_TIMEOUT_MS=30000

# On SIGTERM, keep serving (while /ready reports 503) for this long before
# closing the listening socket. Behind a load balancer set it to at least
# twice the health-check interval, so the balancer stops routing here before
# the socket disappears. 0 locally, so dev and the test scripts exit at once.
READINESS_DRAIN_MS=0

# How long in-flight requests get to finish once the socket is closed.
SHUTDOWN_GRACE_MS=10000
