{
  "uid": "rate-limiter-gateway",
  "title": "Rate Limiter Gateway",
  "tags": ["gateway", "rate-limiting"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Unenforced requests (fail-open, 5m)",
      "description": "Requests served without a rate-limit decision because the limiter could not reach Redis. Anything above zero means the gateway is currently not enforcing limits — the one failure mode nothing else on this dashboard would reveal.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(gateway_requests_total{outcome=\"failed_open\"}[5m])) or vector(0)",
          "legendFormat": "failed open",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Gateway instances reporting",
      "description": "Every instance shares one Redis-backed limit, so scaling this number up must not scale the effective rate limit up with it.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "count(up{job=\"gateway\"} == 1)", "legendFormat": "instances", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Upstream errors (5m)",
      "description": "Requests that passed the rate limit but failed while being proxied. Separates 'the limiter rejected you' from 'the backend is down' — both look like a failed request from outside.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(increase(gateway_upstream_errors_total[5m])) or vector(0)", "legendFormat": "upstream errors", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Rejected share of traffic",
      "description": "How much of the incoming traffic is being throttled right now.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total{outcome=\"rejected\"}[1m])) / clamp_min(sum(rate(gateway_requests_total[1m])), 0.0001)",
          "legendFormat": "rejected",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Decisions per second by algorithm",
      "description": "Allowed vs rejected per algorithm. Under identical load the three lines diverge exactly where the algorithms differ.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum by (algorithm, outcome) (rate(gateway_requests_total[1m]))",
          "legendFormat": "{{algorithm}} · {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } }
    },
    {
      "type": "timeseries",
      "title": "Limiter check p95 — the cost the gateway itself adds",
      "description": "The Redis round-trip alone. Kept separate from end-to-end on purpose: this is the latency the gateway is responsible for, and the number to watch when comparing algorithms.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, algorithm) (rate(gateway_limiter_check_duration_seconds_bucket[1m])))",
          "legendFormat": "{{algorithm}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "End-to-end p95 — what the client actually experiences",
      "description": "Measured on response finish, so it includes the proxy hop to the upstream. The gap between this and the panel to its left is the backend's contribution, not the limiter's.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, algorithm) (rate(gateway_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{algorithm}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Limiter failures by reason",
      "description": "'unavailable' means Redis is gone; 'timeout' means it is up but too slow to sit in the request path. Different incidents, different responses — worth not collapsing into one counter.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "sum by (algorithm, reason) (rate(gateway_limiter_errors_total[1m]))",
          "legendFormat": "{{algorithm}} · {{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
